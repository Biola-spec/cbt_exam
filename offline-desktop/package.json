{
  "name": "cbt-offline-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Installable offline Windows desktop client for the CBT Exam System.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke-test.js",
    "build:win": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cbtexam.offline",
    "productName": "CBT Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "schema",
        "to": "schema"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
